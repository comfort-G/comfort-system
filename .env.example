# Application Settings
ENVIRONMENT=production
SECRET_KEY=your_secure_random_secret_key_here
PASSWORD_RESET_PUBLIC_URL=https://your-app-name.onrender.com

# Database Connection (Neon PostgreSQL Pooler)
DATABASE_URL=postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require

# SMTP Email Configuration (Free Gmail App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_system_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SENDER_EMAIL=your_system_email@gmail.com

# Cloudinary File Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret